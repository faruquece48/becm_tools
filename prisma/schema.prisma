generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model VisitorSession {
  id          String   @id
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  lastSeenDay String

  @@index([lastSeenAt])
  @@index([lastSeenDay])
}

model VisitEvent {
  id        String   @id
  visitedAt DateTime @default(now())
  visitDay  String

  @@index([visitDay])
}

model StudentBillPayment {
  id                    String       @id @default(cuid())
  transactionId         String       @unique
  studentName           String
  email                 String
  phone                 String
  rentalBookCount       Int          @default(0)
  labReportOption       String       @default("none")
  associationYear       Int          @default(0)
  letterOfAttestation   Boolean      @default(false)
  equivalentCertificate Boolean      @default(false)
  amount                Int
  currency              String       @default("BDT")
  status                String       @default("PENDING")
  validationId          String?
  bankTransactionId     String?
  createdAt             DateTime     @default(now())
  paidAt                DateTime?
  updatedAt             DateTime     @updatedAt
  rentalOrder           RentalOrder?
  serviceVerifications  StudentServiceVerification[]

  @@index([email])
  @@index([status])
  @@index([createdAt])
}

model RentalBook {
  id          String            @id @default(cuid())
  title       String
  author      String
  edition     String?
  publication String?
  imageUrl    String
  quantity    Int               @default(0)
  price       Int               @default(20)
  active      Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  items       RentalOrderItem[]
  teacherItems TeacherRentalItem[]

  @@index([active])
  @@index([title])
}

model RentalOrder {
  id           String             @id @default(cuid())
  paymentId    String             @unique
  payment      StudentBillPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  studentName  String
  studentEmail String
  studentPhone String
  status       String             @default("PENDING_PAYMENT")
  rentedAt     DateTime?
  dueAt        DateTime?
  returnedAt   DateTime?
  activationCodeHash   String?   @unique
  activationCodeSentAt DateTime?
  activatedAt          DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  items        RentalOrderItem[]

  @@index([studentEmail])
  @@index([status])
  @@index([dueAt])
}

model RentalOrderItem {
  id        String      @id @default(cuid())
  orderId   String
  order     RentalOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  bookId    String
  book      RentalBook  @relation(fields: [bookId], references: [id])
  quantity  Int         @default(1)
  unitPrice Int
  returnedAt DateTime?

  @@unique([orderId, bookId])
  @@index([bookId])
  @@index([returnedAt])
}

model PortalAccount {
  id           String   @id @default(cuid())
  email        String
  role         String
  name         String?
  phone        String?
  passwordHash             String?
  passwordResetRequestedAt DateTime?
  passwordResetOtpHash      String?
  passwordResetOtpExpiresAt DateTime?
  passwordResetOtpAttempts  Int       @default(0)
  passwordResetLastSentAt   DateTime?
  mustChangePassword        Boolean   @default(false)
  active       Boolean  @default(true)
  registeredAt DateTime @default(now())
  lastLoginAt  DateTime @default(now())
  loginCount   Int      @default(1)
  updatedAt    DateTime @updatedAt

  @@unique([email, role])
  @@index([role])
  @@index([active])
  @@index([lastLoginAt])
}

model StudentProfile {
  id         String   @id @default(cuid())
  email      String   @unique
  name       String
  phone      String
  roll       String
  series     String
  department String   @default("BECM")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([roll])
  @@index([series])
}

model TeacherRentalRecord {
  id           String              @id @default(cuid())
  teacherName  String
  teacherEmail String?
  issuedAt     DateTime            @default(now())
  dueAt        DateTime?
  returnedAt   DateTime?
  status       String              @default("ACTIVE")
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  items        TeacherRentalItem[]

  @@index([teacherName])
  @@index([teacherEmail])
  @@index([status])
}

model TeacherRentalItem {
  id         String              @id @default(cuid())
  recordId   String
  record     TeacherRentalRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  bookId     String
  book       RentalBook          @relation(fields: [bookId], references: [id])
  quantity   Int                 @default(1)
  returnedAt DateTime?

  @@unique([recordId, bookId])
  @@index([bookId])
  @@index([returnedAt])
}
model StaffRemunerationStore {
  id        String   @id
  data      Json
  updatedAt DateTime @updatedAt
}

model TeacherRankStore {
  id        String   @id
  data      Json
  updatedAt DateTime @updatedAt
}
model TeacherCustomizationStore {
  id        String   @id
  teacherId String   @unique
  preview   Json?
  summary   Json?
  updatedAt DateTime @updatedAt
}
model StudentServiceVerification {
  id          String             @id @default(cuid())
  paymentId   String
  payment     StudentBillPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  service     String
  codeHash    String             @unique
  sentAt      DateTime           @default(now())
  verifiedAt  DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@unique([paymentId, service])
  @@index([service, verifiedAt])
}
model TabulatorStore {
  id        String   @id
  data      Json
  updatedAt DateTime @updatedAt
}

model ExamCommitteeStore {
  id        String   @id
  data      Json
  updatedAt DateTime @updatedAt
}
model ResultSectionStore {
  section   String   @id
  data      Json
  updatedAt DateTime @updatedAt
}